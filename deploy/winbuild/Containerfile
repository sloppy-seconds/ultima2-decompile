# u2 winbuild — cross-toolchain container for `make sdl-win`.
#
# Bazzite is immutable; the mingw toolchain belongs in a container, not an
# rpm-ostree layer.
#
# SDL3 is built from the official release tarball rather than taken from a distro
# package, for two reasons. The original one no longer applies: this image used to
# explain that Fedora 42 dropped mingw64-sdl2 and the sdl2-compat replacement is
# shared-only, which defeated the static link — true, and now irrelevant since the
# engine moved to SDL3 (docs/sdl2-vs-sdl3.md § 9). What remains is that a release
# artifact has to be reproducible from a version number, and a distro package is a
# moving target that changes under a cache key. The engine links libSDL3.a and gets
# a single .exe whose only DLL imports are stock Windows ones.
FROM quay.io/fedora/fedora:42
RUN dnf -y install \
        make gcc python3 cmake ninja-build curl tar \
        mingw64-gcc mingw64-gcc-c++ mingw64-winpthreads-static \
    && dnf clean all

# mingw64-gcc-c++ is required by SDL3 and not by SDL2: SDL3's CMakeLists calls
# enable_language(CXX), and the failure is the unhelpful "No CMAKE_CXX_COMPILER
# could be found" rather than "install mingw64-gcc-c++". The compiler is also
# pinned explicitly below rather than left to CMake's search: on a host that has
# its own g++, CMake happily picks /usr/bin/c++ for a cross build and produces a
# broken CMakeCache. That is exactly what the CI runner did, and it only worked
# here by accident because this image has no host C++ compiler to find.

ARG SDL3_VERSION=3.4.18
RUN curl -fL --retry 3 -o /tmp/SDL3.tar.gz \
        "https://github.com/libsdl-org/SDL/releases/download/release-${SDL3_VERSION}/SDL3-${SDL3_VERSION}.tar.gz" \
    && mkdir -p /tmp/sdl3 && tar -xzf /tmp/SDL3.tar.gz -C /tmp/sdl3 \
    && cmake -S "/tmp/sdl3/SDL3-${SDL3_VERSION}" -B /tmp/sdl3/build -G Ninja \
         -DCMAKE_BUILD_TYPE=Release \
         -DCMAKE_SYSTEM_NAME=Windows \
         -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc \
         -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ \
         -DCMAKE_INSTALL_PREFIX=/opt/sdl3 \
         -DBUILD_SHARED_LIBS=OFF -DSDL_SHARED=OFF -DSDL_STATIC=ON \
         -DSDL_TEST_LIBRARY=OFF \
    && cmake --build /tmp/sdl3/build \
    && cmake --install /tmp/sdl3/build \
    && rm -rf /tmp/sdl3 /tmp/SDL3.tar.gz \
    && dnf clean all

# Isolate pkg-config to the mingw world: the cross SDL3 only, no host SDL.
ENV PKG_CONFIG_LIBDIR=/opt/sdl3/lib/pkgconfig

WORKDIR /src
