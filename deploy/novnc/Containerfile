# Engine SDL build, headless, streamed over noVNC.
#
# Game content is NOT in this image, and never will be: the mapx/monx/PLAYER files
# are mounted at runtime (--data-dir read-only, --save-dir read-write). The image
# carries the engine binary and the display plumbing and nothing else.
#
# The binary is built on the host and copied in rather than compiled here, because
# the CI proof and the acceptance suite both run against the host toolchain, and an
# image that recompiles produces a binary nobody tested. Base on Fedora to match the
# host glibc (Bazzite); a much older base would fail to load the binary at runtime
# with an error that looks like a broken build.
FROM fedora:42

# SDL2 runtime for the engine; Xvfb for the display; x11vnc to export it;
# novnc + websockify to reach it from a browser. The engine draws its own glyphs
# from an embedded 8x8 font, so no fonts package is needed.
RUN dnf -y install SDL2 x11vnc xorg-x11-server-Xvfb novnc python3-websockify \
    && dnf clean all

COPY u2-sdl /usr/local/bin/u2-sdl
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/u2-sdl

# Overridable so one host can run several. 6080/5900 are taken by the Spice86
# watching container on ai, so the defaults avoid them.
ENV DISPLAY=:98 \
    VNC_PORT=5901 \
    NOVNC_PORT=6081 \
    GEOMETRY=640x400x24

EXPOSE 5901 6081
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
