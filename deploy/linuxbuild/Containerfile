# u2 linuxbuild — container that produces the static-SDL Linux player binary.
#
# Same shape as winbuild: the toolchain and the SDL3 static build live in the
# image, the host stays untouched (Bazzite is immutable). The output is
# engine/u2-sdl-static: SDL3 linked static, glibc dynamic on purpose (a static
# glibc is a footgun).
#
# The -devel packages below are not optional garnish and this needs saying in the
# file, because the first version of this image shipped a player binary that
# could not open a window on any desktop. SDL's "dlopen at runtime" only removes
# the *runtime* dependency; the backend still has to be configured into the build,
# and SDL's cmake silently compiles out any backend whose headers are missing.
# With none of these installed the resulting libSDL3.a contains `dummy` and
# `offscreen` and nothing else — it links, it passes an ldd check, and it is
# useless. `./u2-sdl-static --video-drivers` is the check that catches it, and
# build.sh runs it.
#
# The SDL3 version and cmake flags MUST stay in step with winbuild's; both come
# from the same pinned official tarball. (winbuild needs none of this: the win32
# backend is built in from the mingw sysroot.)
#
# libXtst-devel is new with SDL3 and is why this image failed the first time it was
# pointed at the new major version: SDL3 enables SDL_X11_XTEST by default and SDL2
# never required it, so cmake stops with "Couldn't find dependency package for
# XTEST" instead of quietly compiling the backend out. The alternative it offers,
# -DSDL_X11_XTEST=OFF, is the wrong fix here: XTEST is what SDL uses for global
# mouse warping and relative-mode input, so switching it off would ship a player
# binary with a hole in it to avoid installing one package.
FROM quay.io/fedora/fedora:42
RUN dnf -y install \
        make gcc python3 cmake ninja-build curl tar \
        libX11-devel libXext-devel libXfixes-devel libXcursor-devel \
        libXi-devel libXinerama-devel libXrandr-devel libXScrnSaver-devel \
        libXtst-devel \
        libxcb-devel libxkbcommon-devel \
        wayland-devel wayland-protocols-devel libdecor-devel \
        mesa-libGL-devel mesa-libEGL-devel libdrm-devel \
        alsa-lib-devel pulseaudio-libs-devel \
    && dnf clean all

ARG SDL3_VERSION=3.4.18
RUN curl -fL --retry 3 -o /tmp/SDL3.tar.gz \
        "https://github.com/libsdl-org/SDL/releases/download/release-${SDL3_VERSION}/SDL3-${SDL3_VERSION}.tar.gz" \
    && mkdir -p /tmp/sdl3 && tar -xzf /tmp/SDL3.tar.gz -C /tmp/sdl3 \
    && cmake -S "/tmp/sdl3/SDL3-${SDL3_VERSION}" -B /tmp/sdl3/build -G Ninja \
         -DCMAKE_BUILD_TYPE=Release \
         -DCMAKE_INSTALL_PREFIX=/opt/sdl3-linux \
         -DBUILD_SHARED_LIBS=OFF -DSDL_SHARED=OFF -DSDL_STATIC=ON \
         -DSDL_TEST_LIBRARY=OFF \
    && cmake --build /tmp/sdl3/build \
    && cmake --install /tmp/sdl3/build \
    && rm -rf /tmp/sdl3 /tmp/SDL3.tar.gz \
    && dnf clean all

WORKDIR /src
