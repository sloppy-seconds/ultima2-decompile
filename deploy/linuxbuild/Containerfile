# u2 linuxbuild — container that produces the static-SDL Linux player binary.
#
# Same shape as winbuild: the toolchain and the SDL2 static build live in the
# image, the host stays untouched (Bazzite is immutable). The output is
# engine/u2-sdl-static: SDL2 linked static, glibc dynamic on purpose (a static
# glibc is a footgun), X11/Wayland/ALSA dlopened by SDL at runtime — so the one
# file runs on any mainstream desktop without installing anything.
#
# The SDL2 version and cmake flags MUST stay in step with winbuild's; both come
# from the same pinned official tarball.
FROM quay.io/fedora/fedora:42
RUN dnf -y install \
        make gcc python3 cmake ninja-build curl tar \
    && dnf clean all

ARG SDL2_VERSION=2.32.8
RUN curl -fL --retry 3 -o /tmp/SDL2.tar.gz \
        "https://github.com/libsdl-org/SDL/releases/download/release-${SDL2_VERSION}/SDL2-${SDL2_VERSION}.tar.gz" \
    && mkdir -p /tmp/sdl2 && tar -xzf /tmp/SDL2.tar.gz -C /tmp/sdl2 \
    && cmake -S "/tmp/sdl2/SDL2-${SDL2_VERSION}" -B /tmp/sdl2/build -G Ninja \
         -DCMAKE_BUILD_TYPE=Release \
         -DCMAKE_INSTALL_PREFIX=/opt/sdl2-linux \
         -DBUILD_SHARED_LIBS=OFF -DSDL_SHARED=OFF -DSDL_STATIC=ON \
         -DSDL_TEST_LIBRARY=OFF \
    && cmake --build /tmp/sdl2/build \
    && cmake --install /tmp/sdl2/build \
    && rm -rf /tmp/sdl2 /tmp/SDL2.tar.gz \
    && dnf clean all

WORKDIR /src
