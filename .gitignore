# ---------------------------------------------------------------------------
# Commit policy (see AGENTS.md "Licensing & Commit Policy" and LICENSE):
# This repo is Apache-2.0 and must NOT redistribute copyrighted game assets or
# GPL/AGPL-incompatible tool builds. Only our own authored source, docs, scripts,
# and curated analysis notes are committed.
# ---------------------------------------------------------------------------

# Copyrighted game binaries/data — never committed. Users supply their own copy.
original/
references/

# Raw runtime dumps of the copyrighted binary (regenerable, derived, bulky).
captures/spice86/*.bin
captures/spice86/*.json

# Full decompiler dumps — bulky derivative working output; regenerate locally.
# (Curated analysis in disasm/*.md|tsv|txt IS committed.)
decompiled/

# Vendored third-party tool builds — GPL / re-fetchable, not our source.
tools/spice86/
tools/reko/

# Scratch run directories (timestamped Spice86 gameplay runs, captures).
tmp/

# Build output.
build/

# OS / editor noise.
.DS_Store
*.swp

# User-authorized external raw runtime captures (see captures/external-20261019/PROVENANCE.md).
# Raw dumps stay out of git per the licensing policy; the provenance note is committed.
captures/external-20261019/**/*.json

# Full linear asm dumps are bulky derived artefacts of the copyrighted
# binary (regenerable via tools/extract_asm.py); keep out of git like decompiled/.
disasm/*.asm

# per-function asm slices (regenerable via tools/make_slices.py)
disasm/functions/

# vendored jwasm build (Open Watcom Public License, re-fetchable; see tools/jwasm/README.md)
tools/jwasm/*
!tools/jwasm/README.md

# local secrets (gh token etc.) — never commit
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Phase 4 engine.
# engine/build/ holds extractor-generated gen_*.h derived from the user's own
# copy of the game — generated game content is never committed (see AGENTS.md
# Licensing & Commit Policy and engine/README.md).
# ---------------------------------------------------------------------------
engine/build/
engine/u2
engine/u2-sdl
engine/tests/*.out

# Raw output of the selfmod runtime-capture scans (scratch; the curated note
# disasm/selfmod-capture.md is what is committed).
disasm/selfmod-raw/
pycache
