# ---------------------------------------------------------------------------
# Commit policy (see AGENTS.md "Licensing & Commit Policy" and LICENSE):
# This repo is Apache-2.0 and must NOT redistribute copyrighted game assets or
# GPL/AGPL-incompatible tool builds. Only our own authored source, docs, scripts,
# and curated analysis notes are committed.
# ---------------------------------------------------------------------------

# Copyrighted game binaries/data — never committed. Users supply their own copy.
original/
references/

# Raw runtime dumps of the copyrighted binary (regenerable, derived, bulky).
# The top-level patterns predate tools/spice86_stop.sh, which harvests into one
# subdirectory per labelled run (captures/spice86/<label>/); those subdirs were
# NOT covered, so a harvest would have staged copyrighted derived dumps into
# git. The directory is ignored wholesale now; curated analysis derived from it
# lives in disasm/ and docs/, which stay tracked.
captures/spice86/
captures/spice86/*.bin
captures/spice86/*.json

# Full decompiler dumps — bulky derivative working output; regenerate locally.
# (Curated analysis in disasm/*.md|tsv|txt IS committed.)
decompiled/

# Vendored third-party tool builds — GPL / re-fetchable, not our source.
# GPL build, never committed. The glob also covers dated backups kept when a
# vendored build is replaced (e.g. spice86.pre-b64fix-20261021), so a stray
# `git add -A` cannot pull 160 MB of GPL binaries into the repo. Trailing slash
# means directories only, so tools/spice86_start.sh and friends stay tracked.
tools/spice86*/
tools/reko/

# Scratch run directories (timestamped Spice86 gameplay runs, captures).
tmp/

# Build output.
build/

# OS / editor noise.
.DS_Store
*.swp

# Owner-supplied screenshots of the running game (evidence for on-screen geometry).
# The image is derived from copyrighted game art, so the file stays out of git and
# only the measurements we derive from it are committed, in docs/. See
# docs/phase4-implementation.md § CP4 "Evidence gap".
captures/screenshots/

# User-authorized external raw runtime captures (see captures/external-20261019/PROVENANCE.md).
# Raw dumps stay out of git per the licensing policy; the provenance note is committed.
captures/external-20261019/**/*.json

# Full linear asm dumps are bulky derived artefacts of the copyrighted
# binary (regenerable via tools/extract_asm.py); keep out of git like decompiled/.
disasm/*.asm

# per-function asm slices (regenerable via tools/make_slices.py)
disasm/functions/

# vendored jwasm build (Open Watcom Public License, re-fetchable; see tools/jwasm/README.md)
tools/jwasm/*
!tools/jwasm/README.md

# local secrets (gh token etc.) — never commit
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Phase 4 engine.
# engine/build/ holds extractor-generated gen_*.h derived from the user's own
# copy of the game — generated game content is never committed (see AGENTS.md
# Licensing & Commit Policy and engine/README.md).
# ---------------------------------------------------------------------------
engine/build/
engine/u2
engine/u2-sdl

# Player saves. The engine writes a byte-compatible PLAYER file into
# --save-dir (default ./saves). That is user data, never a repo artefact.
engine/saves/

# Tile cache. Derived from the player's own executable on first run, stamped
# with its SHA-256, and rebuilt when that digest changes. Game content by
# construction, so it never belongs in the repo wherever --save-dir points.
*.u2tl
engine/tests/*.out

# Raw output of the selfmod runtime-capture scans (scratch; the curated note
# disasm/selfmod-capture.md is what is committed).
disasm/selfmod-raw/

# Python bytecode caches from the tools/ scripts. The previous pattern here was
# `pycache`, which matches nothing: gitignore is not a substring match, so the
# directory is named `__pycache__` and needed the underscores.
__pycache__/
